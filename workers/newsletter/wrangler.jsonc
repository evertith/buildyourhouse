{
  "name": "buildyourhouse-newsletter",
  "main": "src/index.js",
  "vars": {
    // List mail sends from the news subdomain (verified in Resend Nov 18, 2026)
    // so marketing reputation stays apart from order-delivery mail.
    "MARKETING_FROM": "Seth at Build Your House <seth@news.build-your-house.com>",
    "RESEND_AUDIENCE_ID": "c767f3a7-0e17-4731-82b5-940d796f0c92"
  },
  "compatibility_date": "2026-06-01",
  "triggers": {
    "crons": ["0 15 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buildyourhouse-newsletter",
      "database_id": "6e09eebe-be9d-46d9-a1be-2c2e6e2f6ecd"
    }
  ]
}
